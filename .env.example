NODE_ENV=development
DATABASE_URL=postgres://darkevent:darkevent@localhost:5432/darkevent

# ==============================================================================
# SECURITY - CRITICAL: Generate these values BEFORE first run
# ==============================================================================

# Session Secret - REQUIRED (must be at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# QR Code Encryption Keys - REQUIRED
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
QR_ENCRYPTION_IV=CHANGE_THIS_TO_A_RANDOM_32_CHAR_HEX_STRING

# ==============================================================================
# SMTP Configuration for Outlook/Microsoft
# ==============================================================================
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@outlook.com
SMTP_PASS=your-password

# ==============================================================================
# Email Configuration
# ==============================================================================
EMAIL_FROM=your-email@outlook.com
EMAIL_FROM_NAME=Zomb'in The Dark

# Development Mode - All emails will be sent to this address in development
DEV_EMAIL_OVERRIDE=dev@example.com

# Production Mode - Set NODE_ENV=production to send emails to actual participants

# ==============================================================================
# QUICK SETUP - Run these commands to generate secure secrets:
# ==============================================================================
# echo "SESSION_SECRET=$(node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")" >> .env
# echo "QR_ENCRYPTION_KEY=$(node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")" >> .env
# echo "QR_ENCRYPTION_IV=$(node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")" >> .env
