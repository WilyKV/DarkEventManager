NODE_ENV=development
DATABASE_URL=postgres://darkevent:darkevent@localhost:5432/darkevent

# Session Secret
SESSION_SECRET=darkevent-secret-key-change-in-production

# SMTP Configuration for Outlook/Microsoft
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@outlook.com
SMTP_PASS=your-password

# Email Configuration
EMAIL_FROM=your-email@outlook.com
EMAIL_FROM_NAME=Zomb'in The Dark

# Development Mode - All emails will be sent to this address in development
DEV_EMAIL_OVERRIDE=kevin.nicol@hotmail.fr

# Production Mode - Set NODE_ENV=production to send emails to actual participants

# WebSocket HMAC signing secret (multi-instance sync)
# Générer avec : openssl rand -hex 32
WEBSOCKET_SECRET=

# QR code encryption keys (AES-256-CBC)
# Générer avec : openssl rand -hex 32
QR_ENCRYPTION_KEY=

# (Obsolète depuis migration AES-GCM, IV intégré au token. À garder pour compat downgrade.)
# Générer avec : openssl rand -hex 16
QR_ENCRYPTION_IV=

PORT=5000
