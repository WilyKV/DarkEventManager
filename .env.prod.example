# ============================================================
# DarkEventManager — Template .env de PRODUCTION (Jetson)
# ------------------------------------------------------------
# Copier vers ~/DarkEventManager/.env sur le Jetson, chmod 600.
# NE JAMAIS committer le .env réel (exclu par .gitignore / .dockerignore).
#
# Générer un secret fort : openssl rand -hex 32
# ============================================================

NODE_ENV=production
PORT=5000
# Port hôte exposé par le conteneur app (défaut 5000). Changer si conflit.
APP_PORT=5000

# --- Base de données ---
# Interne au réseau docker du projet 'darkevent' (la DB n'est pas exposée).
DATABASE_URL=postgres://darkevent:darkevent@db:5432/darkevent

# --- Secrets applicatifs (OBLIGATOIRES en prod) ---
# SESSION_SECRET : min 32 caractères. L'app REFUSE de démarrer si absent
# ou égal à la valeur par défaut.            -> openssl rand -hex 32
SESSION_SECRET=
# WEBSOCKET_SECRET : min 32 caractères, FIXE (sinon tokens HMAC cassés
# au redémarrage et entre instances).        -> openssl rand -hex 32
WEBSOCKET_SECRET=
# QR_ENCRYPTION_KEY : EXACTEMENT 64 caractères hexadécimaux (32 octets).
#                                             -> openssl rand -hex 32
QR_ENCRYPTION_KEY=

# --- SMTP Outlook (envoi des emails de fin d'événement) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ton-compte@outlook.com
SMTP_PASS=ton-mot-de-passe
EMAIL_FROM=ton-compte@outlook.com
EMAIL_FROM_NAME=Zombin The Dark
