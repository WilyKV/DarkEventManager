# Copier vers le fichier .env de production, en dehors de Git.
# Voir docs/variables-production.md pour générer les valeurs sur la machine cible.
NODE_ENV=production
PORT=5000
APP_PORT=5000
# Le Compose hébergé utilise HOSTED_APP_PORT pour le port interne du proxy.
HOSTED_APP_PORT=80

# Pour docker-compose.hosted.yml, coller l'URL de connexion de l'hébergeur.
# docker-compose.prod.yml définit lui-même l'URL de sa base intégrée.
DATABASE_URL=

# Générer une valeur différente pour chaque clé avec openssl rand -hex 32.
SESSION_SECRET=
WEBSOCKET_SECRET=
QR_ENCRYPTION_KEY=

# Laisser false si l'accueil est le seul usage.
EMAIL_ENABLED=false
# Pour un service d'envoi SMTP, renseigner ces paramètres puis activer EMAIL_ENABLED.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# EMAIL_FROM_NAME=Zomb'in The Dark

LOG_LEVEL=info
LOG_VERBOSE=false
